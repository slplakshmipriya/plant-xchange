# Copy to .env for local dev. NEVER commit .env — it is git-ignored.
# Production values live in Secret Manager, not here. See api/docs/secrets.md.
DATABASE_URL=
FIREBASE_PROJECT_ID=
RATE_LIMIT_PER_MIN=120
LOG_LEVEL=INFO
PORT=8080
# Stripe Connect seam (API-071): stub until StripeConnectGateway is wired.
PAYMENT_PROVIDER=stub
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# IDV (C1): IDV_PROVIDER defaults to "stub". The stub self-verification
# route/provider are DEAD unless ENABLE_IDV_STUB=1 — never enable that in
# production. Set IDV_PROVIDER to the real vendor + IDV_WEBHOOK_SECRET.
IDV_PROVIDER=stub
IDV_WEBHOOK_SECRET=
ENABLE_IDV_STUB=0
# At-rest encryption (fail closed when unset — the API 500s without these).
MESSAGE_ENCRYPTION_KEY=
GEO_ENCRYPTION_KEY=
# Comma-separated Firebase UIDs allowed on the support dashboard.
SUPPORT_UIDS=
