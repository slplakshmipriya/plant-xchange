<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".GardenSwapApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.GardenSwap"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".explore.ExploreActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.PhoneAuthActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.ProfileFormActivity"
            android:exported="false" />
        <activity
            android:name=".onboarding.HomeZipActivity"
            android:exported="false" />
        <activity
            android:name=".idv.IdvActivity"
            android:exported="false" />
        <activity
            android:name=".trees.TreeDetailActivity"
            android:exported="false" />
        <activity
            android:name=".trees.TreeListActivity"
            android:exported="false" />
        <activity
            android:name=".wallet.WalletActivity"
            android:exported="false" />
        <activity
            android:name=".wallet.ConfirmExchangeActivity"
            android:exported="false" />
        <activity
            android:name=".sitters.SitterListActivity"
            android:exported="false" />
        <activity
            android:name=".sitters.BecomeSitterActivity"
            android:exported="false" />
        <activity
            android:name=".sitters.SitterProfileActivity"
            android:exported="false" />
        <activity
            android:name=".sitters.ReviewActivity"
            android:exported="false" />
        <activity
            android:name=".chat.ThreadListActivity"
            android:exported="false" />
        <activity
            android:name=".chat.ChatActivity"
            android:exported="false" />
        <activity
            android:name=".listings.CreateListingActivity"
            android:exported="false" />
        <activity
            android:name=".listings.ListingDetailActivity"
            android:exported="false" />
        <activity
            android:name=".wantlist.WantListActivity"
            android:exported="false" />
        <activity
            android:name=".harvest.HarvestLogActivity"
            android:exported="false" />
        <activity
            android:name=".profile.MySwapsActivity"
            android:exported="false" />
        <activity
            android:name=".profile.ProfileActivity"
            android:exported="false" />
        <activity
            android:name=".notifications.NotificationPrefsActivity"
            android:exported="false" />

        <service
            android:name=".notifications.GardenSwapMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
