<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom-nav icon/text tint (UID-004): brand sky when selected, muted
     sage otherwise. brand_nav_selected / garden_nav_muted resolve per
     night mode. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/brand_nav_selected" />
    <item android:color="@color/garden_nav_muted" />
</selector>
