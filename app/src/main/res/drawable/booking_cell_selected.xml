<?xml version="1.0" encoding="utf-8"?>
<!-- Booking date cell, selected: brand-sky outline + translucent sky tint
     (brand_cell_tint), with a "✓" tick drawn as text on the cell. The deeper
     sky stroke keeps it distinct from the availability strip's lighter one. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="8dp" />
    <solid android:color="@color/brand_cell_tint" />
    <stroke android:width="2dp" android:color="@color/brand_button" />
</shape>
